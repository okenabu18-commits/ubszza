<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="256" height="256">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="bgGrad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#212F3D"/>
      <stop offset="100%" stop-color="#0F171E"/>
    </radialGradient>

    <!-- Character Body Gradient (Vibrant Teal) -->
    <linearGradient id="bodyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#00F0C0"/>
      <stop offset="100%" stop-color="#00A887"/>
    </linearGradient>

    <!-- Feather Highlights -->
    <linearGradient id="featherGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
    </linearGradient>

    <!-- Beak Gradient -->
    <linearGradient id="beakGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFC700"/>
      <stop offset="100%" stop-color="#FF9900"/>
    </linearGradient>

    <!-- Headband Gradient -->
    <linearGradient id="bandGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FF2A6D"/>
      <stop offset="100%" stop-color="#9A00FF"/>
    </linearGradient>

    <!-- Soft Drop Shadow -->
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="4" flood-color="#000000" flood-opacity="0.4"/>
    </filter>

    <!-- Inner Shadow for Eyes -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="256" height="256" rx="56" fill="url(#bgGrad)"/>
  
  <!-- Subtle Background Grid Motif (Subtle Tech Vibe) -->
  <path d="M0 64 H256 M0 128 H256 M0 192 H256 M64 0 V256 M128 0 V256 M192 0 V256" stroke="#FFFFFF" stroke-opacity="0.03" stroke-width="2"/>

  <!-- Character Group -->
  <g filter="url(#shadow)">
    
    <!-- Wings (Left & Right) -->
    <!-- Left Wing -->
    <path d="M 42 135 C 25 145 20 175 38 185 C 55 195 70 170 65 150 Z" fill="#00A887"/>
    <!-- Right Wing -->
    <path d="M 214 135 C 231 145 236 175 218 185 C 201 195 186 170 191 150 Z" fill="#00866C"/>

    <!-- Main Body Shape (Cute Squarish Mascot) -->
    <path d="M 52 90 
             C 52 45, 204 45, 204 90 
             L 204 165 
             C 204 205, 52 205, 52 165 
             Z" fill="url(#bodyGrad)"/>

    <!-- Chest Patch (Belly) -->
    <path d="M 76 130 
             C 76 105, 180 105, 180 130 
             L 180 160 
             C 180 190, 76 190, 76 160 
             Z" fill="#E6FFF9"/>

    <!-- Tech Headband / VR Strap -->
    <path d="M 50 72 Q 128 62 206 72 L 206 86 Q 128 76 50 86 Z" fill="url(#bandGrad)"/>
    <!-- Headband Tech Emblem -->
    <circle cx="128" cy="74" r="7" fill="#00F0C0"/>
    <circle cx="128" cy="74" r="3" fill="#FFFFFF"/>

    <!-- Big Cute Expressive Eyes -->
    <!-- Left Eye Outer -->
    <ellipse cx="92" cy="112" rx="22" ry="25" fill="#FFFFFF"/>
    <!-- Right Eye Outer -->
    <ellipse cx="164" cy="112" rx="22" ry="25" fill="#FFFFFF"/>

    <!-- Left Iris -->
    <ellipse cx="96" cy="112" rx="13" ry="15" fill="#0F171E"/>
    <!-- Right Iris -->
    <ellipse cx="160" cy="112" rx="13" ry="15" fill="#0F171E"/>

    <!-- Eye Highlights (Anime/Mascot Style) -->
    <circle cx="92" cy="105" r="5" fill="#FFFFFF"/>
    <circle cx="101" cy="116" r="2.5" fill="#FFFFFF"/>
    <circle cx="156" cy="105" r="5" fill="#FFFFFF"/>
    <circle cx="165" cy="116" r="2.5" fill="#FFFFFF"/>

    <!-- Beak / Snout -->
    <path d="M 112 120 
             Q 128 114 144 120 
             Q 128 142 112 120 Z" fill="url(#beakGrad)"/>
    <path d="M 116 122 Q 128 126 140 122" stroke="#E68A00" stroke-width="1.5" fill="none"/>

    <!-- Rosy Cheeks -->
    <ellipse cx="72" cy="130" rx="8" ry="5" fill="#FF5252" opacity="0.3"/>
    <ellipse cx="184" cy="130" rx="8" ry="5" fill="#FF5252" opacity="0.3"/>

    <!-- Feather Tuft / Hair Pin on Top -->
    <path d="M 120 50 C 115 30, 130 25, 128 15 C 135 25, 140 35, 134 50 Z" fill="#00F0C0"/>
    <path d="M 128 50 C 130 35, 145 30, 146 20 C 148 32, 145 42, 138 50 Z" fill="#00A887"/>

    <!-- Feet -->
    <!-- Left Foot -->
    <path d="M 85 195 Q 70 215 82 218 Q 92 220 95 200 Z" fill="url(#beakGrad)"/>
    <path d="M 92 197 Q 95 218 102 216 Q 106 212 102 196 Z" fill="url(#beakGrad)"/>
    <!-- Right Foot -->
    <path d="M 154 196 Q 150 212 154 216 Q 164 218 171 197 Z" fill="url(#beakGrad)"/>
    <path d="M 161 200 Q 164 220 174 218 Q 186 215 171 195 Z" fill="url(#beakGrad)"/>

  </g>

  <!-- Floating UI / NPC Quest Badge ("ABUZI.UZ") -->
  <g transform="translate(128, 222)" filter="url(#shadow)">
    <!-- Badge Background -->
    <rect x="-60" y="-14" width="120" height="24" rx="12" fill="#FF2A6D"/>
    <rect x="-58" y="-12" width="116" height="20" rx="10" fill="#1A1D24"/>
    
    <!-- Badge Text -->
    <text x="0" y="2" 
          font-family="'Montserrat', 'Arial Black', sans-serif" 
          font-weight="900" 
          font-size="11" 
          fill="#00F0C0" 
          text-anchor="middle" 
          letter-spacing="0.5">abuzzy.uz</text>
  </g>

  <!-- Interactive NPC Quest Icon (! Floating Marker) -->
  <g transform="translate(128, 12)" filter="url(#shadow)">
    <circle cx="0" cy="0" r="10" fill="#FFC700"/>
    <path d="M -2 -5 L 2 -5 L 1 1 L -1 1 Z" fill="#0F171E"/>
    <circle cx="0" cy="4" r="1.5" fill="#0F171E"/>
  </g>
</svg>
